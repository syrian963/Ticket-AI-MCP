# What tests/fleet.py writes where it is run. A record of one afternoon's API
# calls against somebody else's boards - useful to read, not something to
# carry in the repository.
fleet.json

# Eval run records. The dataset is committed, the results of running it are not:
# they are produced per machine and per model, and a diff of two of them is not
# something anyone reads in a pull request.
evals/results/

# Terraform state names the account and holds whatever the provider read back.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
